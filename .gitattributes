# Visual C++ 6.0 can't load .dsp/.dsw project files with LF line endings,
# so keep all Visual Studio project files as CRLF.
*.dsp     text eol=crlf
*.dsw     text eol=crlf
*.sln     text eol=crlf
*.vcproj  text eol=crlf

# Never convert line endings in the 1997 contest files. (The submitted
# sources were converted from classic Mac CR to LF so GitHub can show them.)
mactech/** -text
